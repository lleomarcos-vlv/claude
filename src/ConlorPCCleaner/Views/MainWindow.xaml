<Window x:Class="ConlorPCCleaner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conlor PC Cleaner"
        Height="790" Width="1220" MinHeight="660" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <!-- ============================ Header ============================ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧹" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Conlor PC Cleaner" Style="{StaticResource H1}" />
                        <TextBlock Text="Limpeza inteligente e segura — seus arquivos pessoais nunca são apagados."
                                   Style="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource WarningBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,14,0"
                            Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠ Sem privilégios de administrador" Foreground="#241B00"
                                       VerticalAlignment="Center" FontWeight="SemiBold" />
                            <Button Content="Reiniciar como Admin" Command="{Binding ElevateCommand}"
                                    Margin="10,0,0,0" Padding="8,4" Cursor="Hand"
                                    Background="#241B00" Foreground="#FFE08A" BorderThickness="0" />
                        </StackPanel>
                    </Border>

                    <CheckBox Content="Modo Simulação" IsChecked="{Binding SimulationMode}"
                              Style="{StaticResource ModernCheckBox}" Margin="0,0,18,0"
                              ToolTip="Mostra exatamente o que seria limpo ou movido, sem alterar nada." />
                    <CheckBox Content="Tema escuro" IsChecked="{Binding IsDarkTheme}"
                              Style="{StaticResource ModernCheckBox}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Body ============================ -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ---------- Sidebar ---------- -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel>
                    <!-- Actions -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ações" Style="{StaticResource H2}" />

                            <Button Style="{StaticResource ActionButton}" Command="{Binding AnalyzeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍" FontSize="18" Margin="0,0,12,0" />
                                    <TextBlock Text="Analisar PC" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ActionButton}" Command="{Binding SmartCleanCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✨" FontSize="18" Margin="0,0,12,0" />
                                    <TextBlock Text="Limpeza Inteligente" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ActionButton}" Command="{Binding TransferCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦" FontSize="18" Margin="0,0,12,0" />
                                    <TextBlock Text="Transferir para HD Externo" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ActionButton}" Command="{Binding FullCleanCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧨" FontSize="18" Margin="0,0,12,0" />
                                    <TextBlock Text="Limpeza Completa" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ActionButton}" Command="{Binding RestoreCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↩️" FontSize="18" Margin="0,0,12,0" />
                                    <TextBlock Text="Restaurar Backup" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ActionButton}" Command="{Binding SettingsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="18" Margin="0,0,12,0" />
                                    <TextBlock Text="Configurações" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Content="⛔ Cancelar operação" Style="{StaticResource DangerButton}"
                                    Command="{Binding CancelCommand}" Margin="0,6,0,0"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="📄 Relatório" Style="{StaticResource GhostButton}" Padding="10,6"
                                        Command="{Binding OpenLastReportCommand}" Margin="0,0,8,0" />
                                <Button Content="📁 Pasta" Style="{StaticResource GhostButton}" Padding="10,6"
                                        Command="{Binding OpenReportsFolderCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- System drive -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="💽 Disco do sistema" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding SystemDrive.DisplayName}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <ProgressBar Style="{StaticResource ModernProgress}" Maximum="100"
                                         Value="{Binding SystemDrive.UsedPercent}" Margin="0,10" />
                            <Grid>
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="Usado: " /><Run Text="{Binding SystemDrive.UsedBytes, Converter={StaticResource Bytes}, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource Muted}">
                                    <Run Text="Livre: " /><Run Text="{Binding SystemDrive.FreeBytes, Converter={StaticResource Bytes}, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Muted}">
                                <Run Text="Total: " /><Run Text="{Binding SystemDrive.TotalBytes, Converter={StaticResource Bytes}, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- External drive -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="🔌 HD externo" Style="{StaticResource H2}" />
                                <Button Content="🔄" HorizontalAlignment="Right" Padding="8,2"
                                        Style="{StaticResource GhostButton}" Command="{Binding RefreshDrivesCommand}"
                                        ToolTip="Atualizar unidades" />
                            </Grid>

                            <ComboBox Style="{StaticResource ModernCombo}" Margin="0,4,0,0"
                                      ItemsSource="{Binding ExternalDrives}"
                                      SelectedItem="{Binding SelectedExternalDrive}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="Nenhum HD externo detectado. Conecte um dispositivo e clique em 🔄.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedExternalDrive}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Margin="0,10,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedExternalDrive}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ProgressBar Style="{StaticResource ModernProgress}" Maximum="100"
                                             Value="{Binding SelectedExternalDrive.UsedPercent}" />
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Muted}">
                                        <Run Text="Livre: " /><Run Text="{Binding SelectedExternalDrive.FreeBytes, Converter={StaticResource Bytes}, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource Muted}">
                                        <Run Text="Total: " /><Run Text="{Binding SelectedExternalDrive.TotalBytes, Converter={StaticResource Bytes}, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ---------- Content ---------- -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="6">
                <TabControl>
                    <!-- Tab: Analysis -->
                    <TabItem Header="Análise">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Stat cards -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}" Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedReclaimableText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Accent2Brush}" />
                                        <TextBlock Text="Selecionado p/ limpar" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ReclaimableText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="Recuperável (total)" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MovableText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="Pode ir p/ HD externo" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource Card}" Background="{DynamicResource SurfaceAltBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DuplicateText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                                        <TextBlock Text="Duplicados" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Category toolbar -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,8">
                                <TextBlock Text="Categorias de limpeza" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                <Button Content="Marcar todos" Style="{StaticResource GhostButton}" Padding="10,4" Margin="14,0,8,0"
                                        Click="SelectAllCategories_Click" />
                                <Button Content="Desmarcar" Style="{StaticResource GhostButton}" Padding="10,4"
                                        Click="DeselectAllCategories_Click" />
                            </StackPanel>

                            <!-- Categories list -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Categories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected}" VerticalAlignment="Center"
                                                              IsEnabled="{Binding IsCleanable}" Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                                            <Border Background="{DynamicResource WarningBrush}" CornerRadius="6" Padding="6,1" Margin="8,0,0,0"
                                                                    Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="admin" FontSize="10" Foreground="#241B00" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Accent2Brush}"
                                                               Text="{Binding TotalBytes, Converter={StaticResource Bytes}, Mode=OneWay}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- Tab: Large files -->
                    <TabItem Header="Arquivos grandes">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource H2}" VerticalAlignment="Center">
                                    <Run Text="Arquivos pessoais grandes — " /><Run Text="{Binding MovableText, Mode=OneWay}" />
                                </TextBlock>
                                <Button Content="Marcar todos" Style="{StaticResource GhostButton}" Padding="10,4" Margin="14,0,8,0"
                                        Click="SelectAllFiles_Click" />
                                <Button Content="Desmarcar" Style="{StaticResource GhostButton}" Padding="10,4"
                                        Click="DeselectAllFiles_Click" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LargeFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8"
                                                    Padding="10,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="8,2" Margin="8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               Text="{Binding SizeBytes, Converter={StaticResource Bytes}, Mode=OneWay}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- Tab: Duplicates -->
                    <TabItem Header="Duplicados">
                        <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Duplicates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔁" FontSize="16" Margin="0,0,8,0" />
                                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}">
                                                        <Run Text="{Binding Paths.Count, Mode=OneWay}" /><Run Text=" cópias · " />
                                                        <Run Text="{Binding SizeBytesEach, Converter={StaticResource Bytes}, Mode=OneWay}" /><Run Text=" cada · recuperável " />
                                                        <Run Text="{Binding ReclaimableBytes, Converter={StaticResource Bytes}, Mode=OneWay}" Foreground="#FFC24B" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Paths}" Margin="24,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab: Disks & Apps -->
                    <TabItem Header="Discos &amp; Apps">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Disk health -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="🩺 Saúde dos discos (SMART)" Style="{StaticResource H2}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                                    <ItemsControl ItemsSource="{Binding DiskHealth}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Model}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding MediaType}" Style="{StaticResource Muted}" Margin="0,0,10,0" />
                                                            <TextBlock Text="{Binding SizeBytes, Converter={StaticResource Bytes}, Mode=OneWay}" Style="{StaticResource Muted}" Margin="0,0,10,0" />
                                                            <TextBlock Text="{Binding HealthStatus}" FontWeight="SemiBold" Foreground="{DynamicResource Accent2Brush}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>

                            <!-- Developer / game caches -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="🧰 Caches de apps, VMs e jogos (informativo)" Style="{StaticResource H2}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                                    <ItemsControl ItemsSource="{Binding DeveloperCaches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                    <Grid>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                                            <TextBlock Text="{Binding Category}" Style="{StaticResource Muted}" />
                                                        </StackPanel>
                                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Text="{Binding SizeBytes, Converter={StaticResource Bytes}, Mode=OneWay}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- ============================ Progress / status ============================ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}"
                               Text="{Binding Progress, StringFormat={}{0:0}%}" />
                </Grid>
                <ProgressBar Style="{StaticResource ModernProgress}" Maximum="100" Value="{Binding Progress}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- ============================ Log console ============================ -->
        <Border Grid.Row="3" Background="#0B0E18" Padding="14,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="LOGS EM TEMPO REAL" Foreground="#8891AE"
                           FontSize="11" FontWeight="SemiBold" Margin="2,0,0,6" />
                <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" Background="Transparent"
                         BorderThickness="0" Foreground="#D6DCEC"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Formatted}" FontFamily="Consolas, Courier New"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{Binding Level, Converter={StaticResource LogBrush}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
