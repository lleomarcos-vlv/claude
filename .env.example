# =============================================================================
# Variáveis de ambiente · copie para .env.local e preencha
# NUNCA versione o .env.local. NUNCA coloque chave de serviço no frontend.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Públicas: podem ir para o navegador (a RLS é quem protege os dados).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Secreta: SOMENTE no servidor. Ignora RLS — nunca exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Banco local para desenvolvimento e testes de migration
DATABASE_URL=postgresql://grafista@localhost:55432/grafista

# --- Agente fiscal local (Windows, na loja) ---------------------------------
AGENTE_LOCAL_URL=http://localhost:8079
AGENTE_LOCAL_TOKEN=
# Caminho do certificado A1 na máquina da loja. Nunca sai do computador local.
CERTIFICADO_A1_CAMINHO=
CERTIFICADO_A1_SENHA=
# producao | homologacao — comece sempre em homologacao
SEFAZ_AMBIENTE=homologacao

# --- Integrações (Fase 9) ---------------------------------------------------
# Preencher só quando a integração for de fato conectada. Vazio = não conectado,
# e a interface deve exibir exatamente isso.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
META_APP_ID=
META_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
MERCADOLIVRE_APP_ID=
MERCADOLIVRE_SECRET=
