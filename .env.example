# ─────────────────────────────────────────────────────────────
# JardimJá — Environment variables (copy to .env and fill in)
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
API_PORT=3333
API_BASE_URL=http://localhost:3333
WEB_ADMIN_URL=http://localhost:5173

# ── Database (PostgreSQL + PostGIS) ──────────────────────────
DATABASE_URL=postgresql://jardimja:jardimja@localhost:5432/jardimja?schema=public
# Read replica (optional, for reporting/BI queries)
DATABASE_REPLICA_URL=

# ── Cache / queues (Redis) ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-32+chars
JWT_ACCESS_TTL=900          # 15 minutes
JWT_REFRESH_TTL=2592000     # 30 days
# Supabase Auth (optional — alternative to built-in JWT)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Firebase Auth (optional)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── AI providers (multimodal vision + LLM) ───────────────────
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-5
# Which providers participate in the consensus (comma separated)
AI_VISION_PROVIDERS=openai,gemini,anthropic
# Minimum providers that must succeed before we trust an estimate
AI_VISION_MIN_QUORUM=2

# ── Object storage (S3 compatible: AWS S3 / Cloudflare R2) ────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jardimja-media
S3_ACCESS_KEY_ID=jardimja
S3_SECRET_ACCESS_KEY=jardimja-secret
S3_PUBLIC_URL=http://localhost:9000/jardimja-media
S3_FORCE_PATH_STYLE=true

# ── Maps / geolocation ───────────────────────────────────────
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# ── Payments ─────────────────────────────────────────────────
PAYMENTS_PROVIDER=mercadopago     # mercadopago | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=10           # marketplace commission (%)

# ── Push notifications (FCM) ─────────────────────────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── Observability ────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info

# ── Pricing engine tuning ────────────────────────────────────
PRICING_DEFAULT_CITY=São Paulo
PRICING_FUEL_PRICE_PER_LITER=6.20
PRICING_CURRENCY=BRL
