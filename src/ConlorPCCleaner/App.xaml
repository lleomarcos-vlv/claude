<Application x:Class="ConlorPCCleaner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ConlorPCCleaner.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters available to every view. -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:BytesToStringConverter x:Key="Bytes" />
            <conv:LogLevelToBrushConverter x:Key="LogBrush" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
            <conv:InverseBooleanConverter x:Key="InvBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
