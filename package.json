{
  "name": "padaria-villa-reis",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicativo web e painel administrativo da Padaria Villa Reis",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push && npm run seed",
    "test:e2e": "tsx tests/e2e.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jose": "6.2.12",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}