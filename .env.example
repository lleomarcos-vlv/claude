# ---------------------------------------------------------------------------
# PADARIA VILLA REIS - variaveis de ambiente
# Copie este arquivo para .env e ajuste os valores.
# ---------------------------------------------------------------------------

# Banco de dados
# Desenvolvimento (SQLite, padrao):
DATABASE_URL="file:./dev.db"
# Producao (PostgreSQL). Troque tambem o provider em prisma/schema.prisma:
# DATABASE_URL="postgresql://usuario:senha@host:5432/villareis?schema=public"

# Chave usada para assinar a sessao do painel administrativo.
# Gere uma nova com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="troque-esta-chave-por-uma-aleatoria-de-64-caracteres-no-minimo"

# Credenciais do primeiro administrador (usadas apenas pelo comando de seed)
ADMIN_EMAIL="admin@villareis.com.br"
ADMIN_PASSWORD="VillaReis@2026"
ADMIN_NAME="Administrador Villa Reis"

# URL publica do site (SEO, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# STORAGE DE FOTOS E VIDEOS
# local    -> grava em disco (pasta UPLOAD_DIR). Exige disco persistente.
# supabase -> Supabase Storage
# s3       -> AWS S3, Cloudflare R2, Backblaze B2, MinIO (compativel com S3)
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
UPLOAD_DIR="./storage/uploads"

# Supabase Storage (quando STORAGE_DRIVER=supabase)
# SUPABASE_URL="https://xxxxxxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="..."
# SUPABASE_BUCKET="villa-reis"

# S3 / R2 / MinIO (quando STORAGE_DRIVER=s3)
# S3_BUCKET="villa-reis"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
# S3_PUBLIC_URL="https://cdn.suapadaria.com.br"
# S3_FORCE_PATH_STYLE="true"

# ---------------------------------------------------------------------------
# Processamento de imagem
# O arquivo ORIGINAL enviado pelo administrador e sempre preservado intacto.
# As variantes abaixo sao geradas apenas para acelerar o carregamento.
# ---------------------------------------------------------------------------
IMAGE_VARIANT_FORMAT="webp"     # webp | avif
IMAGE_DESKTOP_WIDTH="1600"
IMAGE_MOBILE_WIDTH="800"
IMAGE_THUMB_WIDTH="480"
IMAGE_DESKTOP_QUALITY="86"
IMAGE_MOBILE_QUALITY="82"
IMAGE_THUMB_QUALITY="80"

# Limites de upload (MB)
MAX_IMAGE_MB="25"
MAX_VIDEO_MB="200"
