# =============================================================================
# Verde Fixo — variáveis de ambiente
#
# Copie para `.env` e preencha o que for usar. O site roda sem nenhuma das
# integrações: pagamentos e notificações caem em "modo demonstração" e ficam
# registrados no painel administrativo como SIMULADO.
# =============================================================================

# --- Obrigatórias -----------------------------------------------------------

# SQLite local em desenvolvimento. Em produção use Postgres:
#   postgresql://usuario:senha@host:5432/verdefixo?schema=public
# (troque também o `provider` em prisma/schema.prisma)
DATABASE_URL="file:./verde-fixo.db"

# Assina os cookies de sessão e os desafios de captcha.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# URL pública, sem barra final. Usada em canonical, Open Graph e sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# --- Notificações e automações ---------------------------------------------

# WhatsApp — Meta Cloud API
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# E-mail transacional — Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Verde Fixo <contato@verdefixo.com.br>"

# Alternativa ao Resend: qualquer webhook que receba { to, subject, text }
EMAIL_WEBHOOK_URL=""

# Avisa a equipe a cada novo agendamento/orçamento (Slack, Discord, n8n…)
TEAM_WEBHOOK_URL=""

# Protege /api/cron/*. Envie como: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""


# --- Pagamentos -------------------------------------------------------------

# Mercado Pago (PIX, cartão e boleto) — provedor preferencial quando presente
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Stripe (assinatura recorrente com cartão)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# PIX estático (BR Code) — usado quando não há gateway configurado
PIX_KEY=""
PIX_MERCHANT_NAME="VERDE FIXO"
PIX_MERCHANT_CITY="CAMPINAS"


# --- Medição (carregada só após consentimento LGPD) -------------------------

NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Mapa interativo na página de contato. Sem chave, mostramos o mapa estático.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""


# --- Captcha ----------------------------------------------------------------

# Por padrão usamos um desafio aritmético próprio, sem script de terceiros.
# Preencha para trocar por hCaptcha:
HCAPTCHA_SECRET=""
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=""

# Desativa o captcha (apenas para testes automatizados)
CAPTCHA_DISABLED=""


# --- Seed -------------------------------------------------------------------

# Senha das contas de demonstração criadas por `npm run db:seed`
SEED_PASSWORD="verdefixo123"
