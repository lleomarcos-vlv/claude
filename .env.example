# geoAG — Assistência Técnica de Drones DJI Agras · Goiânia-GO
# Variáveis de produção. Copie para ".env" e ajuste:
#   cp .env.example .env
# Nunca versione o .env com segredos reais.

# Banco de dados
DB_NAME=geoag
DB_USER=geoag
DB_PASSWORD=coloque-uma-senha-forte-do-banco

# Segurança (OBRIGATÓRIO trocar): segredo dos tokens, 32+ caracteres, único.
KAIROS_JWT_SECRET=troque-por-uma-frase-secreta-bem-grande-com-mais-de-32-caracteres

# Origens do frontend permitidas (CSV). Ajuste para o domínio do geoAG.
KAIROS_CORS_ORIGINS=https://app.geoag.com.br

# --- Onboarding do cliente geoAG -----------------------------------------
# Deixe true SOMENTE no primeiro boot de produção: cria a empresa geoAG + o
# usuário ADMIN. É idempotente (não duplica). Depois pode voltar para false.
GEOAG_ONBOARDING_SEED=true
# CNPJ real do geoAG (troque o placeholder antes de ir ao ar).
GEOAG_CNPJ=00.000.000/0001-00
# Acesso inicial do administrador — TROQUE A SENHA no primeiro login.
GEOAG_ADMIN_EMAIL=contato@geoag.com.br
GEOAG_ADMIN_SENHA=geoag-trocar-esta-senha-2026

# Demonstração: deixe false em produção. Use true só para treinar a equipe
# num ambiente separado (dados fictícios "Conlor Drones (Demo)").
KAIROS_DEMO_SEED=false
